# Dashboard container: gRPC collector, WebSocket bridge and static UI
FROM python:3.11-slim

WORKDIR /app

COPY dashboard/requirements.txt dashboard/
RUN pip install --no-cache-dir -r dashboard/requirements.txt

COPY protos/ protos/
COPY dashboard/ dashboard/

# Python stubs are generated at build time so live mode works out of the box
RUN python3 dashboard/gen_protos.py

WORKDIR /app/dashboard

# 8000 static UI, 8765 WebSocket, 50051 gRPC telemetry in
EXPOSE 8000 8765 50051

CMD ["python3", "-u", "telemetry_receiver.py", "--mode", "grpc"]
